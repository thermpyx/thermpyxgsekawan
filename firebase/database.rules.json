{
  "rules": {
    ".read": false,
    ".write": false,
    "questionSets": {
      "$ownerUid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $ownerUid",
        "$setId": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $ownerUid",
          ".validate": "newData.hasChildren(['id','owner_id','title','topic','questions','created_at'])",
          "id": {
            ".validate": "(newData.isString() && newData.val() === $setId && newData.val().length <= 128) && (!data.exists() || newData.val() === data.val())"
          },
          "owner_id": {
            ".validate": "(newData.isString() && newData.val() === $ownerUid) && (!data.exists() || newData.val() === data.val())"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
          },
          "topic": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "questions": {
            ".validate": "newData.hasChild('0')",
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9][0-9]?)$/) && newData.hasChildren(['question','options','correctAnswer'])",
              "question": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
              },
              "options": {
                ".validate": "newData.hasChildren(['0','1','2','3']) && newData.child('0').val().toLowerCase() !== newData.child('1').val().toLowerCase() && newData.child('0').val().toLowerCase() !== newData.child('2').val().toLowerCase() && newData.child('0').val().toLowerCase() !== newData.child('3').val().toLowerCase() && newData.child('1').val().toLowerCase() !== newData.child('2').val().toLowerCase() && newData.child('1').val().toLowerCase() !== newData.child('3').val().toLowerCase() && newData.child('2').val().toLowerCase() !== newData.child('3').val().toLowerCase()",
                "0": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
                },
                "1": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
                },
                "2": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
                },
                "3": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
                },
                "$other": {
                  ".validate": false
                }
              },
              "correctAnswer": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 3"
              },
              "explanation": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 3000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "created_at": {
            ".validate": "(newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)) && (!data.exists() || newData.val() === data.val())"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && $code.matches(/^[0-9]{6}$/) && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.child('ownerUid').val() === auth.uid && ((!newData.exists() && (!root.child('rooms').child(data.child('roomId').val()).exists() || root.child('rooms').child(data.child('roomId').val()).child('status').val() === 'finished')) || (newData.child('roomId').val() === data.child('roomId').val() && newData.child('ownerUid').val() === data.child('ownerUid').val() && newData.child('createdAt').val() === data.child('createdAt').val()))))",
        ".validate": "newData.hasChildren(['roomId','ownerUid','createdAt'])",
        "roomId": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (root.child('rooms').child($roomId).child('owner_id').val() === auth.uid || root.child('players').child($roomId).child(auth.uid).exists())",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && !data.exists() && newData.child('owner_id').val() === auth.uid && root.child('roomCodes').child(newData.child('room_code').val()).child('ownerUid').val() === auth.uid && root.child('roomCodes').child(newData.child('room_code').val()).child('roomId').val() === $roomId",
        ".validate": "newData.hasChildren(['id','owner_id','room_code','status','topic','questions','is_custom','created_at'])",
        "id": {
          ".validate": "newData.isString() && newData.val() === $roomId && newData.val().length <= 128"
        },
        "owner_id": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "room_code": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
        },
        "status": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && root.child('rooms').child($roomId).child('owner_id').val() === auth.uid && data.exists() && ((data.val() === 'waiting' && (newData.val() === 'playing' || newData.val() === 'finished')) || (data.val() === 'playing' && newData.val() === 'finished') || newData.val() === data.val())",
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === 'waiting') || (data.exists() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')))",
          ".read": "auth != null"
        },
        "topic": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "questions": {
          ".validate": "newData.hasChild('0')",
          "$index": {
            ".validate": "$index.matches(/^(0|[1-9][0-9]?)$/) && newData.hasChildren(['question','options','correctAnswer'])",
            "question": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
            },
            "options": {
              ".validate": "newData.hasChildren(['0','1','2','3']) && newData.child('0').val().toLowerCase() !== newData.child('1').val().toLowerCase() && newData.child('0').val().toLowerCase() !== newData.child('2').val().toLowerCase() && newData.child('0').val().toLowerCase() !== newData.child('3').val().toLowerCase() && newData.child('1').val().toLowerCase() !== newData.child('2').val().toLowerCase() && newData.child('1').val().toLowerCase() !== newData.child('3').val().toLowerCase() && newData.child('2').val().toLowerCase() !== newData.child('3').val().toLowerCase()",
              "0": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
              },
              "1": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
              },
              "2": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
              },
              "3": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
              },
              "$other": {
                ".validate": false
              }
            },
            "correctAnswer": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 3"
            },
            "explanation": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 3000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "is_custom": {
          ".validate": "newData.isBoolean()"
        },
        "created_at": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "players": {
      "$roomId": {
        ".read": "auth != null && (root.child('rooms').child($roomId).child('owner_id').val() === auth.uid || root.child('players').child($roomId).child(auth.uid).exists())",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).exists() && ((!data.exists() && newData.exists() && root.child('rooms').child($roomId).child('status').val() === 'waiting' && root.child('nicknameClaims').child($roomId).child(newData.child('nickname_key').val()).val() === auth.uid) || (data.exists() && newData.exists() && (root.child('rooms').child($roomId).child('status').val() === 'waiting' || root.child('rooms').child($roomId).child('status').val() === 'playing')) || (data.exists() && !newData.exists() && root.child('rooms').child($roomId).child('status').val() === 'waiting'))",
          ".validate": "newData.hasChildren(['id','room_id','nickname','nickname_key','joined_at','current_question'])",
          "id": {
            ".validate": "(newData.isString() && newData.val() === $uid) && (!data.exists() || newData.val() === data.val())"
          },
          "room_id": {
            ".validate": "(newData.isString() && newData.val() === $roomId) && (!data.exists() || newData.val() === data.val())"
          },
          "nickname": {
            ".validate": "(newData.isString() && newData.val().length >= 1 && newData.val().length <= 30) && (!data.exists() || newData.val() === data.val())"
          },
          "nickname_key": {
            ".validate": "(newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)) && (!data.exists() || newData.val() === data.val())"
          },
          "joined_at": {
            ".validate": "(newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)) && (!data.exists() || newData.val() === data.val())"
          },
          "current_question": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= -1 && newData.val() <= 100 && ((!data.exists() && newData.val() === 0) || (data.exists() && ((root.child('rooms').child($roomId).child('status').val() === 'waiting' && newData.val() === 0) || (root.child('rooms').child($roomId).child('status').val() === 'playing' && (data.val() !== -1 || newData.val() === -1)))))"
          },
          "question_started_at": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "answers": {
      "$roomId": {
        ".read": "auth != null && (root.child('rooms').child($roomId).child('owner_id').val() === auth.uid || root.child('players').child($roomId).child(auth.uid).exists())",
        "$uid": {
          "$index": {
            ".write": "auth != null && auth.uid === $uid && root.child('players').child($roomId).child(auth.uid).exists() && root.child('players').child($roomId).child(auth.uid).child('current_question').val() !== -1 && root.child('rooms').child($roomId).child('status').val() === 'playing' && !data.exists() && newData.exists() && $index.matches(/^(0|[1-9][0-9]?)$/) && root.child('rooms').child($roomId).child('questions').child($index).exists()",
            ".validate": "newData.hasChildren(['id','room_id','player_id','question_index','selected_answer','is_correct','score','response_time_ms','created_at']) && newData.child('is_correct').val() === (newData.child('selected_answer').val() === root.child('rooms').child($roomId).child('questions').child($index).child('correctAnswer').val()) && newData.child('score').val() === (newData.child('is_correct').val() ? 100 : 0) && (newData.child('selected_answer').val() !== -1 || newData.child('response_time_ms').val() === 20000)",
            "id": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 256"
            },
            "room_id": {
              ".validate": "newData.isString() && newData.val() === $roomId"
            },
            "player_id": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "question_index": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 99 && newData.val() + '' === $index"
            },
            "selected_answer": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= -1 && newData.val() <= 3"
            },
            "is_correct": {
              ".validate": "newData.isBoolean()"
            },
            "score": {
              ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 100)"
            },
            "response_time_ms": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000"
            },
            "created_at": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "nicknameClaims": {
      "$roomId": {
        "$key": {
          ".read": "auth != null",
          ".write": "auth != null && $key.matches(/^[a-f0-9]{64}$/) && root.child('rooms').child($roomId).child('status').val() === 'waiting' && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        }
      }
    }
  }
}
